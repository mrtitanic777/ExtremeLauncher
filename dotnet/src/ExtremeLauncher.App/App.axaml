<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ExtremeLauncher.App.App"
             RequestedThemeVariant="Default">

  <!-- Default follows the desktop's own light/dark setting, which is what a user expects of a native
       application and what Qt gave them for free. -->
  <Application.Styles>
    <FluentTheme />

    <!-- App-wide polish, so all twenty-odd windows share one look rather than each being raw Fluent. -->
    <Style Selector="Window">
      <Setter Property="FontFamily"
              Value="Segoe UI, Inter, -apple-system, Ubuntu, Cantarell, sans-serif" />

      <!-- A real canvas colour. Fluent's default window background is SystemAltHigh, which is pure
           black in dark and pure white in light, so an empty content area rendered as a black void
           in dark mode. AppCanvasBrush is our own app-background layer, one step below the card
           surface, so the instance cards read as raised in both themes. -->
      <Setter Property="Background" Value="{DynamicResource AppCanvasBrush}" />
    </Style>

    <!-- Toolbar and dialog buttons: a touch more room and a softer corner than the stock control, and
         a real 1px edge (its colour comes from the ButtonBorderBrush overrides above) so a button
         reads as a button on either theme. -->
    <Style Selector="Button">
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- The hero action (Launch): filled with the accent so the one button people came to press reads
         as the primary one instead of being lost in a row of identical grey buttons. -->
    <Style Selector="Button.hero">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.hero:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.hero:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    </Style>

    <!-- The main toolbar wraps instead of clipping off the window edge, with even gaps between items. -->
    <Style Selector="WrapPanel.toolbar > Button, WrapPanel.toolbar > TextBox, WrapPanel.toolbar > ComboBox">
      <Setter Property="Margin" Value="0,2,6,2" />
    </Style>

    <!-- A hairline between toolbar groups, so a dozen buttons read as a few labelled clusters rather
         than one undifferentiated wall. -->
    <Style Selector="Border.tool-sep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="4,6" />
      <Setter Property="Background" Value="{DynamicResource AppCardStrokeBrush}" />
    </Style>

    <!-- Toolbar button glyphs: one consistent size, tinted to follow the button's own foreground so
         they dim with a disabled button and brighten on hover. -->
    <Style Selector="PathIcon.tbi">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>

    <!-- An icon-only button (Settings, the folder/help glyphs): square, so a lone glyph is not
         stranded in a wide pill. -->
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="8" />
      <Setter Property="MinWidth" Value="38" />
    </Style>

    <!-- Section headings used across the pages (group names, "How", "Copy", etc.). -->
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,6" />
    </Style>

    <!-- A quiet filled pill for the one-word qualifiers that sit beside a name (required, dependency,
         customised on the version page): metadata should read as a chip, not as more of the sentence. -->
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Style>

    <!-- The warning variant, for a state the user needs to notice rather than merely read: a disabled
         mod or an unreadable save. Same quiet pill, but in the error colour. -->
    <Style Selector="Border.badge.warn > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
    </Style>

    <!-- Form field captions (settings, server editor): a consistent muted label with a little air
         under it, instead of an ad-hoc 11px TextBlock jammed against its input. -->
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <!-- The settings groups' own tick box doubles as the section heading, so it carries a heading's
         weight rather than looking like just another option. -->
    <Style Selector="CheckBox.group-title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- A denser list for scanning: the component list is read top-to-bottom, so it should not waste
         a Fluent row's full height on each line. -->
    <Style Selector="ListBox.compact ListBoxItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- The instance window's page navigation reads as a modern sidebar: no box around it, and each
         page is a rounded row that fills the width, so the accent selection lands as a pill rather
         than a hard-edged bar butting against the window frame. -->
    <Style Selector="ListBox.page-nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.page-nav ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,1" />
    </Style>

    <!-- The instance tiles on the main window: a real raised card, with a hover and a clear selected
         state. The card is an inner Border we fully control, NOT the Button's own chrome: a Fluent
         Button paints its own ButtonBackground (a light overlay that is near-white in the dark theme)
         and does not reliably honour an overridden background, which is why the cards looked right in
         light and wrong in dark. The Button itself is made chromeless and the opaque Border covers it,
         so the look is identical in both themes. -->
    <Style Selector="Button.instance-tile">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.instance-tile /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- CardBackgroundFillColorDefault is Fluent's dedicated card surface and is genuinely theme-aware
         (a light card in light, a dark card in dark), unlike the "Chrome" keys, several of which do
         not invert and left the cards near-white in the dark theme. -->
    <Style Selector="Border.tile-card">
      <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCardStrokeBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.instance-tile:pointerover Border.tile-card">
      <Setter Property="Background" Value="{DynamicResource AppCardHoverBrush}" />
    </Style>

    <!-- Selected: the accent border carries it, so the card stays readable in both themes. A filled
         accent wash would put the dark theme's light card text on pale green, i.e. unreadable. -->
    <Style Selector="Button.instance-tile.selected Border.tile-card">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>

      <!-- Our own surface palette, defined per theme so the colours are exact and predictable.
           Avalonia's Fluent semantic brushes proved unreliable across themes (some "Chrome" keys do
           not invert; SolidBackgroundFillColorBase is white in the dark theme), which is what left the
           cards near-white and, once, the whole canvas white. These are the layers, darkest to
           lightest in dark / lightest to "white card" in light: canvas < toolbar < card < card hover. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppCanvasBrush" Color="#ECECEC" />
          <SolidColorBrush x:Key="AppToolbarBrush" Color="#F6F6F6" />
          <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppCardHoverBrush" Color="#F2F2F2" />
          <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#DCDCDC" />

          <!-- Buttons, overriding Fluent's own keys so every button in the app reads as a real button:
               a defined surface, a visible edge and a clear hover, instead of a muddy grey blob. -->
          <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F4F4F4" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E8E8E8" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#EDEDED" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CFCFCF" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#BCBCBC" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#C4C4C4" />
          <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#E2E2E2" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#1A1A1A" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#000000" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#333333" />
          <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#ABABAB" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppCanvasBrush" Color="#1E1E1E" />
          <SolidColorBrush x:Key="AppToolbarBrush" Color="#262626" />
          <SolidColorBrush x:Key="AppCardBrush" Color="#2D2D2D" />
          <SolidColorBrush x:Key="AppCardHoverBrush" Color="#383838" />
          <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#3C3C3C" />

          <SolidColorBrush x:Key="ButtonBackground" Color="#343434" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3F3F3F" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2C2C2C" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#282828" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#4C4C4C" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#5C5C5C" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#3C3C3C" />
          <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#333333" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#ECECEC" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#D8D8D8" />
          <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6E6E6E" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- A grass-green accent, thematic for a Minecraft launcher and distinct from stock Fluent blue.
           FluentTheme uses SystemAccentColor for controls; the light/dark shades are the hover/pressed
           and tint steps, set explicitly because Fluent does not derive them on its own. -->
      <Color x:Key="SystemAccentColor">#3FA34D</Color>
      <Color x:Key="SystemAccentColorDark1">#379345</Color>
      <Color x:Key="SystemAccentColorDark2">#2F803B</Color>
      <Color x:Key="SystemAccentColorDark3">#276B31</Color>
      <Color x:Key="SystemAccentColorLight1">#57B463</Color>
      <Color x:Key="SystemAccentColorLight2">#7AC684</Color>
      <Color x:Key="SystemAccentColorLight3">#A6DCAD</Color>

      <!-- Toolbar icons (Material Design Icons, Pictogrammers, Apache-2.0), one path each at a 24x24
           viewbox, so they drop straight into a PathIcon. -->
      <StreamGeometry x:Key="IconNew">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
      <StreamGeometry x:Key="IconModpacks">M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L10.11,5.22L16,8.61L17.96,7.5L12,4.15M6.04,7.5L12,10.85L13.96,9.75L8.08,6.35L6.04,7.5M5,15.91L11,19.29V12.58L5,9.21V15.91M19,15.91V9.21L13,12.58V19.29L19,15.91Z</StreamGeometry>
      <StreamGeometry x:Key="IconImport">M2 12H4V17H20V12H22V17C22 18.11 21.11 19 20 19H4C2.9 19 2 18.11 2 17V12M12 15L17.55 9.54L16.13 8.13L13 11.25V2H11V11.25L7.88 8.13L6.46 9.55L12 15Z</StreamGeometry>
      <StreamGeometry x:Key="IconLaunch">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
      <StreamGeometry x:Key="IconKill">M18,18H6V6H18V18Z</StreamGeometry>
      <StreamGeometry x:Key="IconEdit">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</StreamGeometry>
      <StreamGeometry x:Key="IconMore">M16,12A2,2 0 0,1 18,10A2,2 0 0,1 20,12A2,2 0 0,1 18,14A2,2 0 0,1 16,12M10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12M4,12A2,2 0 0,1 6,10A2,2 0 0,1 8,12A2,2 0 0,1 6,14A2,2 0 0,1 4,12Z</StreamGeometry>
      <StreamGeometry x:Key="IconFolders">M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z</StreamGeometry>
      <StreamGeometry x:Key="IconHelp">M11,18H13V16H11V18M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,6A4,4 0 0,0 8,10H10A2,2 0 0,1 12,8A2,2 0 0,1 14,10C14,12 11,11.75 11,15H13C13,12.75 16,12.5 16,10A4,4 0 0,0 12,6Z</StreamGeometry>
      <StreamGeometry x:Key="IconAbout">M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M10,22C9.75,22 9.54,21.82 9.5,21.58L9.13,18.93C8.5,18.68 7.96,18.34 7.44,17.94L4.95,18.95C4.73,19.03 4.46,18.95 4.34,18.73L2.34,15.27C2.21,15.05 2.27,14.78 2.46,14.63L4.57,12.97L4.5,12L4.57,11L2.46,9.37C2.27,9.22 2.21,8.95 2.34,8.73L4.34,5.27C4.46,5.05 4.73,4.96 4.95,5.05L7.44,6.05C7.96,5.66 8.5,5.32 9.13,5.07L9.5,2.42C9.54,2.18 9.75,2 10,2H14C14.25,2 14.46,2.18 14.5,2.42L14.87,5.07C15.5,5.32 16.04,5.66 16.56,6.05L19.05,5.05C19.27,4.96 19.54,5.05 19.66,5.27L21.66,8.73C21.79,8.95 21.73,9.22 21.54,9.37L19.43,11L19.5,12L19.43,13L21.54,14.63C21.73,14.78 21.79,15.05 21.66,15.27L19.66,18.73C19.54,18.95 19.27,19.04 19.05,18.95L16.56,17.95C16.04,18.34 15.5,18.68 14.87,18.93L14.5,21.58C14.46,21.82 14.25,22 14,22H10M11.25,4L10.88,6.61C9.68,6.86 8.62,7.5 7.85,8.39L5.44,7.35L4.69,8.65L6.8,10.2C6.4,11.37 6.4,12.64 6.8,13.8L4.68,15.36L5.43,16.66L7.86,15.62C8.63,16.5 9.68,17.14 10.87,17.38L11.24,20H12.76L13.13,17.39C14.32,17.14 15.37,16.5 16.14,15.62L18.57,16.66L19.32,15.36L17.2,13.81C17.6,12.64 17.6,11.37 17.2,10.2L19.31,8.65L18.56,7.35L16.15,8.39C15.38,7.5 14.32,6.86 13.12,6.62L12.75,4H11.25Z</StreamGeometry>

<!--
  SPDX-License-Identifier: GPL-3.0-only

  The classic FTB pack browser: the catalogue on the left, the highlighted pack's details and version
  on the right. Mirrors the Modrinth pack browser, minus the search button (the list is filtered live).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ExtremeLauncher.ViewModels"
        xmlns:app="using:ExtremeLauncher.App"
        x:Class="ExtremeLauncher.App.LegacyFtbBrowserWindow"
        x:DataType="vm:LegacyFtbBrowserViewModel"
        Title="Install a classic FTB pack"
        Width="900" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppCanvasBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40">

  <DockPanel>
    <app:TitleBar DockPanel.Dock="Top" />
    <DockPanel Margin="12">

      <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="{Binding Status}" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <!-- Cancel is the default, as everywhere else: a stray Return must not start an install. -->
            <Button Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" />
            <Button Name="InstallButton" Content="Install" Classes="hero"
                    IsEnabled="{Binding CanInstall}" />
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
        <TextBox Width="360"
                 Watermark="Filter packs"
                 Text="{Binding SearchText, Mode=TwoWay}" />

        <ProgressBar IsIndeterminate="True" Width="90" VerticalAlignment="Center"
                     IsVisible="{Binding IsLoading}" />
      </StackPanel>

      <Grid ColumnDefinitions="2*,8,3*">

        <ListBox Grid.Column="0"
                 ItemsSource="{Binding Packs}"
                 SelectedItem="{Binding SelectedPack, Mode=TwoWay}" Classes="compact">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LegacyFtbPackRow">
              <StackPanel Margin="0,1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Classes="badge"><TextBlock Text="{Binding SourceLabel}" /></Border>
                  <Border Classes="badge warn" IsVisible="{Binding IsBroken}">
                    <TextBlock Text="no versions" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding Author}" FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

        <DockPanel Grid.Column="2" IsVisible="{Binding SelectedPack, Converter={x:Static ObjectConverters.IsNotNull}}">

          <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="15"
                     Text="{Binding SelectedPack.Name}" />

          <TextBlock DockPanel.Dock="Top" Margin="0,4,0,10" TextWrapping="Wrap"
                     Text="{Binding SelectedPack.Description}" />

          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="4">
            <TextBlock Classes="field-label" Text="Instance name" />
            <TextBox Text="{Binding InstanceName, Mode=TwoWay}"
                     Watermark="{Binding SelectedPack.Name}" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="4">
            <TextBlock Classes="field-label" Text="Version" />
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Versions}"
                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" />
          </StackPanel>

          <TextBlock />
        </DockPanel>
      </Grid>
    </DockPanel>
  </DockPanel>
</Window>

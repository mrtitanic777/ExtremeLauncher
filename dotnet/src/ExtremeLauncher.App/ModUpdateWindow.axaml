<!--
  SPDX-License-Identifier: GPL-3.0-only

  Upstream's ModUpdateDialog: what is out of date, and which of it to take.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:ExtremeLauncher.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ExtremeLauncher.ViewModels"
        mc:Ignorable="d"
        x:Class="ExtremeLauncher.App.ModUpdateWindow"
        x:DataType="vm:ModUpdateViewModel"
        Title="Update mods"
        Width="620" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppCanvasBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40">

  <DockPanel>
    <app:TitleBar DockPanel.Dock="Top" />
    <DockPanel Margin="12">

    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Button Grid.Column="0" Content="All" Command="{Binding SelectAllCommand}" />
        <Button Grid.Column="1" Margin="6,0,0,0" Content="None" Command="{Binding SelectNoneCommand}" />

        <TextBlock Grid.Column="2" Margin="12,0" VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{Binding Status}" />

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
          <Button Name="CloseButton" Content="Close" IsCancel="True" IsDefault="True" />
          <Button Content="{Binding ApplyLabel}" Classes="hero"
                  Command="{Binding ApplyCommand}"
                  IsEnabled="{Binding CanApply}" />
        </StackPanel>
      </Grid>
    </Border>

    <ListBox ItemsSource="{Binding Updates}" Classes="compact">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ModUpdateRowViewModel">
          <Grid ColumnDefinitions="Auto,*">
            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                      IsChecked="{Binding IsChosen, Mode=TwoWay}" />

            <StackPanel Grid.Column="1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding NewVersionName}" FontWeight="SemiBold" VerticalAlignment="Center" />

                <!-- Said outright: updating a disabled mod leaves it disabled, and somebody who does
                     not know that will wonder why the new version is not loading. -->
                <Border Classes="badge warn" IsVisible="{Binding IsDisabledMod}"
                        ToolTip.Tip="This mod is disabled; updating it leaves it disabled.">
                  <TextBlock Text="stays disabled" />
                </Border>
              </StackPanel>

              <TextBlock Text="{Binding Change}"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
  </DockPanel>
</Window>

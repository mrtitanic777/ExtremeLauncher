<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ExtremeLauncher.ViewModels"
        xmlns:app="using:ExtremeLauncher.App"
        x:Class="ExtremeLauncher.App.NewInstanceWindow"
        x:DataType="vm:NewInstanceViewModel"
        Title="New instance"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppCanvasBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40">

  <DockPanel>
    <app:TitleBar DockPanel.Dock="Top" />
    <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <TextBlock Classes="field-label" Text="Name" />
      <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="What to call this instance" />

      <TextBlock Classes="field-label" Text="Group (optional)" />
      <TextBox Text="{Binding Group, Mode=TwoWay}" Watermark="Leave empty for none" />

      <!-- Hidden by default, as upstream hides them: the real list is well over a thousand entries,
           nearly all of them 2011 alphas and weekly snapshots. -->
      <CheckBox Content="Show snapshots and old versions"
                IsChecked="{Binding ShowAllVersions, Mode=TwoWay}"
                Margin="0,6,0,0" />

      <TextBlock Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
    </StackPanel>

    <!-- The buttons, along the bottom. Create is disabled until there is both a name and a version:
         an unnamed instance is a directory called nothing, and an unchosen version is the typo the
         list exists to prevent. -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <ProgressBar Width="120" IsIndeterminate="True"
                   IsVisible="{Binding IsLoading}"
                   VerticalAlignment="Center" />
      <Button Content="Cancel" Name="CancelButton" IsDefault="True" MinWidth="90" />
      <Button Content="Create" Name="CreateButton" Classes="hero" MinWidth="90"
              IsEnabled="{Binding CanCreate}" />
    </StackPanel>

    <!-- The loader, below the Minecraft list. Forge and NeoForge publish a build per Minecraft
         version and are filtered by it; Fabric and Quilt declare nothing, so every version is offered
         from 1.14 onwards and none before. See NewInstanceViewModel. -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
      <TextBlock Classes="field-label" Text="Mod loader" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox Width="140"
                  ItemsSource="{Binding Loaders}"
                  SelectedItem="{Binding Loader, Mode=TwoWay}" />

        <ComboBox Width="200"
                  ItemsSource="{Binding LoaderVersions}"
                  SelectedItem="{Binding SelectedLoaderVersion}"
                  IsVisible="{Binding !Loader.IsNone}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:VersionViewModel">
              <TextBlock Text="{Binding Version}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="{Binding LoaderNote}"
                   IsVisible="{Binding LoaderNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      </StackPanel>
    </StackPanel>

    <Border Margin="0,12,0,0" BorderThickness="1" CornerRadius="6"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected}" Classes="compact">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:VersionViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Version}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ReleasedString}"
                         FontSize="11" VerticalAlignment="Center"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              <Border Classes="badge" IsVisible="{Binding !IsRelease}">
                <TextBlock Text="{Binding Type}" />
              </Border>
              <Border Classes="badge" IsVisible="{Binding IsRecommended}">
                <TextBlock Text="latest" />
              </Border>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    </DockPanel>
  </DockPanel>
</Window>

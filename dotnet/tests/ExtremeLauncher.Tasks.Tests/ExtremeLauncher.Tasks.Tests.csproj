<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ExtremeLauncher.Tasks.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Symlink creation needs Developer Mode or elevation on Windows; report those as skipped. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExtremeLauncher.Tasks\ExtremeLauncher.Tasks.csproj" />
  </ItemGroup>

  <!--
    Reuse the Qt suite's fixture tree verbatim rather than copying it, so both implementations are
    held to a single shared contract. Mirrors tests/testdata/FileSystem/test_folder.
  -->
  <ItemGroup>
    <Content Include="..\..\..\tests\testdata\FileSystem\test_folder\**\*"
             Link="testdata\FileSystem\test_folder\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
